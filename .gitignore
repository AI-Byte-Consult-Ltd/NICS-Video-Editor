# Виртуальное окружение
venv/
__pycache__/
*.pyc

# Локальные модели (скачиваются отдельно, см. scripts/setup/)
models/

# Пользовательские данные — исходники, кэш анализа, результаты
input/
output/
analysis/
jobs/
logs/

# Музыка и образцы обложек — лицензионные/объёмные бинарные файлы,
# не распространяются вместе с кодом
assets/

# ОС/редактор
.DS_Store
Thumbs.db
.vscode/
.idea/

# Worker secrets
scripts/worker.env
work/
